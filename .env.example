# EduPulse Environment Configuration Template
# Copy this file to .env to customize your configuration

# Data Warehouse Database URL (Defaults to local SQLite warehouse)
# SQLite:
DATABASE_URL=sqlite:///database/edupulse_dw.db

# PostgreSQL (Alternative):
# DATABASE_URL=postgresql://edupulse_user:edupulse_pass@localhost:5432/edupulse_dw

# Operational OLTP Database URL
OLTP_DATABASE_URL=sqlite:///database/edupulse_oltp.db

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Logging Level
LOG_LEVEL=INFO
