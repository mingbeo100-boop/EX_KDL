{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Khởi chạy EduPulse (Full System)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start_local.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⚡ EduPulse Backend API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
